# Virtual environments
venv/
.venv/
__pycache__/
*.pyc

# Local system & database secrets
uploads/
backups/

# run_mes_portable.bat's bundled database - a real PostgreSQL data
# directory (pgserver), specific to whichever PC it was created on.
pgdata/

# PyCharm configuration
.idea/
.vscode/

# OS metadata
.DS_Store
Thumbs.db

# Secrets — never commit. Use .env.example as the shared template.
.env
*.env
!.env.example

# Per-PC HTTPS certificate and private key (setup/generate_tls_cert.py).
# Every machine gets its own — never commit the key.
certs/

# Update-signing private key (setup/update_signing.py / dev/make_update.py
# --init-keys). Lives only on the machine that builds releases — never here,
# never on a plant PC. The matching public key IS committed: it's
# setup/update_signing_public.pem, not this file.
dev/update_signing_private.pem

# Local database files and dumps
*.db
*.sql

# Editor / tooling noise
.idea/
.vscode/

# Generated: combine.py rebuilds this on demand
combined_code.txt

# Runtime output
logs/
resin_backups/

# Rollback copies taken before edits
*.bak
*.bak_*
*.bak[0-9]*

# Move-to-new-PC build artefacts: pip download cache and the package itself
wheels/
_MOVE_PACKAGE/
formlabs_mes_move_*.zip

# Visual regression screenshots: photographs of one database on one machine.
# A baseline captured elsewhere reports every page as changed on yours, so
# each install generates its own with `visual_regression.py --approve`.
tests/visual_baseline/
tests/visual_current/
tests/visual_diffs/

# Scratch left by tooling that cannot delete files here
_to_delete/

# The desktop app drops a copy of anything sent into the chat here. The
# deliverables already live at the repo root; this folder is duplicates.
Claude outputs/

# built update packages - shipped by hand or the update server, not git
dist/
