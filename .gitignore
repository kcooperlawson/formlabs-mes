combined_code.txt

# Runtime output
logs/
resin_backups/

# Rollback copies taken before edits
*.bak
*.bak_*
*.bak[0-9]*

# Move-to-new-PC build artefacts: pip download cache and the package itself
wheels/
_MOVE_PACKAGE/
formlabs_mes_move_*.zip

# Visual regression screenshots: photographs of one database on one machine.
# A baseline captured elsewhere reports every page as changed on yours, so
# each install generates its own with `visual_regression.py --approve`.
tests/visual_baseline/
tests/visual_current/
tests/visual_diffs/

# Scratch left by tooling that cannot delete files here
_to_delete/
