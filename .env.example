# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string used by the app and the migrations
DB_URL=postgresql://USER:PASSWORD@localhost:5432/formlabs_mes

# Password for the Postgres role above (used by the backup/restore utilities)
PG_PASS=

# Apps Script / webhook endpoint the Google Sheets sync posts to (optional -
# leave empty and the sync page simply says it is not configured)
GOOGLE_SHEETS_WEBHOOK=

# Folder containing pg_dump and psql, e.g. C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=

# Encrypts Device Gateway connection details (gateway_crypto.py) - MQTT/OPC-UA
# usernames and passwords, mainly. Leave this blank: it is generated
# automatically the first time a device is saved and appended to .env, the
# same way everything above it is filled in by setup rather than by hand.
GATEWAY_ENCRYPTION_KEY=

# --- Where this PC looks for updates --------------------------------------
# Point it at your own update server (dev/update_server.py) and GitHub is
# never involved. Any address works: a home PC with one port open, a NAS, a
# web host. The package is signed either way, so the connection itself does
# not have to be trusted.
#   MES_UPDATE_URL=http://your-home-address:8443/latest.json
#   MES_UPDATE_TOKEN=          the --token you started that server with
#   MES_UPDATE_INSECURE=0      1 = accept a self-signed HTTPS certificate
MES_UPDATE_URL=
MES_UPDATE_TOKEN=
MES_UPDATE_INSECURE=0

# --- Auto-update (dev/make_update.py --publish, api/routers/updates.py) ---
# Only needed on the machine that publishes releases (home/dev PC) - a
# plant PC checking for and applying updates never needs either of these,
# since GitHub Releases on a public repo are readable with no token.
#
# On a PRIVATE repo, a plant PC also needs a token here just to SEE a
# release - a read-only one (fine-grained, Contents: Read on that one repo)
# is enough, and is not the same token you publish with. A plant PC with no
# token says so plainly instead of reporting "no release published yet".
#
# A GitHub personal access token that can create releases on the project's
# repo. Use a fine-grained token scoped to just this one repo with
# "Contents: Read and write" permission (github.com -> Settings ->
# Developer settings -> Personal access tokens), not a broad classic token.
# Leave blank on every PC except the one you actually publish updates from.
GITHUB_RELEASE_TOKEN=

# owner/repo to check/publish against. Leave blank to use the project's own
# default (kcooperlawson/pouring_mes_logger) - only set this if you're running a
# fork or a private mirror that publishes somewhere else.
GITHUB_UPDATE_REPO=

# --- Bundled database on the network (START_HERE.bat option 15) -----------
# Only on an MES PC that uses the bundled database AND has a Device Gateway
# on another PC. Written by setup/portable_lan_access.py - don't edit by
# hand. Off means the database stays private to this PC (127.0.0.1, a fresh
# port every start, no password), which is the default and the safer state.
PORTABLE_DB_LAN=0
PORTABLE_DB_PORT=5433
PORTABLE_DB_PASSWORD=

# Publishing releases from inside the app (IT Admin -> Updates -> Publish).
# Off everywhere except the one PC that holds dev/update_signing_private.pem:
# a signed release is trusted by every plant PC, so it is not something an
# admin session on a plant PC should be able to produce.
MES_ALLOW_PUBLISH=0
